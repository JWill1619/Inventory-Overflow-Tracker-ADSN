# Server-only, restricted adsn_app role. No NEXT_PUBLIC database credentials.
DATABASE_URL=postgresql://adsn_app:REPLACE@127.0.0.1:5432/postgres
# Used ONLY for migrations and supervisor password rotation:
ADMIN_DATABASE_URL=postgresql://postgres:REPLACE@127.0.0.1:5432/postgres
APP_ORIGIN=http://localhost:3000
# production requires https origin and true, after actual private network verification
PRIVATE_ACCESS_CONFIRMED=false
# Use require for remote connections (certificate verification enabled).
DATABASE_SSL=disable
